}

// angle-out-of-range: A relative angle of 90 degrees or more cannot be inside a camera frame.
fun vector12(): Int {
    let failures: Int = 0;
    let produced: Int = 0;
    // detection 1: id 17
    const status1: Int = status(true, 59.9505, 30.311, true, 90.0, 17, 90.0, 10.0);
