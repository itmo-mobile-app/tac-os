    failures = failures + check(produced == 0);
    return report(failures == 0, "angle-out-of-range-ok");
}

// zero-distance: Distance must be greater than 0.
fun vector13(): Int {
    let failures: Int = 0;
    let produced: Int = 0;
    // detection 1: id 17
    const status1: Int = status(true, 59.9505, 30.311, true, 90.0, 17, 0.0, 0.0);
    failures = failures + check(status1 == 5);  // INVALID_DISTANCE
    failures = failures + check(produced == 0);
    return report(failures == 0, "zero-distance-ok");
}

// beyond-maximum-range: Distance above MAX_RANGE_M is rejected.
fun vector14(): Int {
    let failures: Int = 0;
    let produced: Int = 0;
    // detection 1: id 17
    const status1: Int = status(true, 59.9505, 30.311, true, 90.0, 17, 0.0, 100.01);
    failures = failures + check(status1 == 5);  // INVALID_DISTANCE
    failures = failures + check(produced == 0);
    return report(failures == 0, "beyond-maximum-range-ok");
}

// invalid-detection-does-not-hide-valid-one: Every detection is judged on its own: id 18 is rejected, id 23 still produces an Observation.
fun vector15(): Int {
    let failures: Int = 0;
    let produced: Int = 0;
    // detection 1: id 18
    const status1: Int = status(true, 59.9505, 30.311, true, 350.0, 18, 0.0, -2.0);
    failures = failures + check(status1 == 5);  // INVALID_DISTANCE
    // detection 2: id 23
    const status2: Int = status(true, 59.9505, 30.311, true, 350.0, 23, -8.4, 5.7);
    if (status2 == 0) {
        produced = produced + 1;
        failures = failures + check(near(targetLatitude(59.9505, 350.0, -8.4, 5.7), 59.950548640648));
        failures = failures + check(near(targetLongitude(59.9505, 30.311, 350.0, -8.4, 5.7), 30.310967687161));
        failures = failures + check(near(localConfidence(5.7), 0.732899022801));
    } else {
        failures = failures + 1;
    }
    failures = failures + check(produced == 1);
    return report(failures == 0, "invalid-detection-does-not-hide-valid-one-ok");
}

// antimeridian: The calculated longitude would exceed 180 degrees: the antimeridian is not supported.
fun vector16(): Int {
    let failures: Int = 0;
    let produced: Int = 0;
    // detection 1: id 17
    const status1: Int = status(true, 0.0, 179.99999, true, 90.0, 17, 0.0, 10.0);
    failures = failures + check(status1 == 6);  // INVALID_RESULT
    failures = failures + check(produced == 0);
    return report(failures == 0, "antimeridian-ok");
}

fun main() {
    let failures: Int = 0;
    failures = failures + vector01();
    failures = failures + vector02();
    failures = failures + vector03();
    failures = failures + vector04();
    failures = failures + vector05();
    failures = failures + vector06();
    failures = failures + vector07();
    failures = failures + vector08();
    failures = failures + vector09();
    failures = failures + vector10();
    failures = failures + vector11();
    failures = failures + vector12();
    failures = failures + vector13();
    failures = failures + vector14();
    failures = failures + vector15();
    failures = failures + vector16();
    if (failures == 0) {
        runtime.log("analyzer-observation-ok");
    } else {
        runtime.log("analyzer-observation-failed");
    }
    runtime.log(fixtureDelivery());
}


// ---- IPC delivery from real calculated values, not from a prebuilt message ----
// The input arrays and pose are fixtures for Sprint 4. Camera/device integration is #142.

fun observationJson(id: Int, observerId: String, latitude: Float, longitude: Float,
                    confidence: Float, timestamp: Int): String {
    let message: String = "{\"type\":\"OBSERVATION\",\"targetId\":";
    message = text.concat(message, json.quote(text.fromInt(id)));
    message = text.concat(message, ",\"observerId\":");
    message = text.concat(message, json.quote(observerId));
    message = text.concat(message, ",\"latitude\":");
    message = text.concat(message, text.fromFloat(latitude));
    message = text.concat(message, ",\"longitude\":");
    message = text.concat(message, text.fromFloat(longitude));
    message = text.concat(message, ",\"confidence\":");
    message = text.concat(message, text.fromFloat(confidence));
    message = text.concat(message, ",\"timestamp\":");
    message = text.concat(message, text.fromInt(timestamp));
    return text.concat(message, "}");
}

// Returns number of successfully sent Observations, or -1 if any send failed.
// Invalid individual detections are ignored without hiding valid detections.
// This deliberately uses the same status/calculation/confidence as the 16 vector tests.
fun transmitDetections(detections: String, observerId: String, timestamp: Int,
                       positionAvailable: Bool, deviceLatitude: Float, deviceLongitude: Float,
                       headingAvailable: Bool, heading: Float): Int {
    const count: Int = json.arrayLength(detections);
    let index: Int = 0;
    let sent: Int = 0;
    let failed: Bool = false;
    while (index < count) {
        const detection: String = json.arrayObject(detections, index);
        const id: Int = json.getInt(detection, "id");
        const relativeAngle: Float = json.getFloat(detection, "relativeAngle");
        const distance: Float = json.getFloat(detection, "distance");
        if (status(positionAvailable, deviceLatitude, deviceLongitude,
                   headingAvailable, heading, id, relativeAngle, distance) == 0) {
            const latitude: Float = targetLatitude(deviceLatitude, heading, relativeAngle, distance);
            const longitude: Float = targetLongitude(deviceLatitude, deviceLongitude,
                                                     heading, relativeAngle, distance);
            const confidence: Float = localConfidence(distance);
            const message: String = observationJson(id, observerId, latitude, longitude,
                                                    confidence, timestamp);
            if (runtime.ipc_send(message) == 0) {
                sent = sent + 1;
            } else {
                failed = true;
            }
        }
        index = index + 1;
    }
    if (failed) {
        return -1;
    }
    return sent;
}

// Exercise 0, 1, 2 detections and a mixed invalid+valid frame.
// With Map absent, all send attempts return -1 without stopping the VM.
// With a live Map, four actual serialized Observations cross the IPC socket.
fun fixtureDelivery(): String {
    const zero: Int = transmitDetections("[]", "device-1", 1800000000100,
                                         true, 59.9505, 30.311, true, 90.0);
    const one: Int = transmitDetections(
        "[{\"id\":17,\"relativeAngle\":0.0,\"distance\":10.0}]",
        "device-1", 1800000000100, true, 59.9505, 30.311, true, 90.0);
    const two: Int = transmitDetections(
        "[{\"id\":17,\"relativeAngle\":12.5,\"distance\":3.2},{\"id\":23,\"relativeAngle\":-8.4,\"distance\":5.7}]",
        "device-2", 9007199254740993, true, 59.9505, 30.311, true, 350.0);
    const mixed: Int = transmitDetections(
        "[{\"id\":18,\"relativeAngle\":0.0,\"distance\":-2.0},{\"id\":23,\"relativeAngle\":-8.4,\"distance\":5.7}]",
        "device-3", 1800000000101, true, 59.9505, 30.311, true, 350.0);
    if (zero == 0) {
        if (one == 1) {
            if (two == 2) {
                if (mixed == 1) {
                    return "analyzer-ipc-sent";
                }
            }
        }
        if (one == -1) {
            if (two == -1) {
                if (mixed == -1) {
                    return "analyzer-ipc-unavailable";
                }
            }
        }
    }
    return "analyzer-ipc-failed";
}
